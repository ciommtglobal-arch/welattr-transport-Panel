# Secret: create this in Replit Secrets, never commit the value.
TELEGRAM_BOT_TOKEN=
TELEGRAM_VIP_BOT_TOKEN=

# Get this from /id while a message is inside the target supergroup.
TELEGRAM_GROUP_ID=-1001234567890

# Set the username in Telegram first: Group Info > Edit > Group Type > Public.
# Do not include the @ sign.
TELEGRAM_PUBLIC_USERNAME=mmt_global_operasyon

# Get each value by sending /id inside the relevant forum topic.
LOADS_TOPIC_ID=
EMPTY_VEHICLES_TOPIC_ID=

# VIP bot settings. The channel ID is not a secret.
TELEGRAM_VIP_CHANNEL_ID=-1004409778193
VIP_PRICE_STARS=250
VIP_ACCESS_DAYS=30

# Optional comma-separated Telegram user IDs who may use /links.
TELEGRAM_MODERATOR_IDS=

# Telegram user IDs who receive messages sent to the bot as an operations contact.
# Get an ID by sending /id in a private chat with the bot.
TELEGRAM_CONTACT_ADMIN_IDS=

# External links are removed unless their host is listed here.
ALLOWED_LINK_DOMAINS=t.me,mmtglobal.com.tr,mmt-global-website-1.replit.app

# A member is banned after this many moderation strikes.
BAN_AFTER_STRIKES=3